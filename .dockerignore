# API 이미지(Dockerfile.api) 빌드 컨텍스트에서 뺄 것.
# 비밀값 파일은 절대 이미지·컨텍스트에 들어가면 안 된다(.env.server 포함).
.env
.env.*
!.env.example
**/.env
**/.env.*

.git
.claude
**/node_modules
**/dist
**/coverage
**/*.log
**/*.tsbuildinfo

# 웹은 서버에서 따로 빌드해 nginx 가 서빙한다. 락파일 검증에 package.json 만 필요하다.
apps/web/*
!apps/web/package.json

docs
deploy
legacy
output
scripts/*
!scripts/build-api.mjs
apps/api/test-integration
apps/api/qa
**/*.test.ts
